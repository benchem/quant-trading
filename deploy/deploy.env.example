# quant-trading 服务端环境变量（首次部署时自动复制为 /opt/quant-trading/.env）
# 修改后执行 systemctl restart quant-analyzer quant-planwatch 生效。

# ---- AI 综合分析（可选）----
# 留空 AI_API_KEY 则该功能自动停用，其余功能不受影响。
AI_API_KEY=
AI_BASE_URL=https://api.deepseek.com/v1
AI_MODEL=deepseek-chat
AI_TIMEOUT=60

# ---- Clash 代理（可选）----
# 限流(403/429)时自动轮换出口节点。服务器本地 clash external-controller 地址；
# 留空则走代码内置自动发现（unix socket / 9097 / 9090）。
CLASH_API=127.0.0.1:9090

# ---- 昨夜美股简报邮件推送（可选）----
# 渠道沿用 iam 服务器 github-trending-push 项目的 email 通道（QQ 邮箱 SMTP）。
# 留空 SMTP_USER/SMTP_PASS/MAIL_TO 则该功能自动停用，其余功能不受影响。
SMTP_HOST=smtp.qq.com
SMTP_PORT=587            # 465 走 SSL，其余走 STARTTLS
SMTP_USER=               # 发件邮箱（如 xxx@qq.com）
SMTP_PASS=               # SMTP 授权码（QQ 邮箱设置里生成，非登录密码）
MAIL_FROM=               # 发件地址，留空同 SMTP_USER
MAIL_TO=                 # 收件人，逗号分隔可多个
US_BRIEF_PUSH_HOUR=8     # 推送时刻（CST 小时，默认 8）
US_BRIEF_PUSH_MINUTE=40  # 推送时刻（CST 分钟，默认 40；简报通常 08:30 后落盘）
US_BRIEF_PUSH_RETRY=30,30,30  # 简报未就绪时的重试间隔（分钟，逗号分隔）
MAIL_DRY_RUN=false       # true 只记日志不真发信（调试用）
